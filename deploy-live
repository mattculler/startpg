#!/bin/sh
# Deploy startpg to the production VM over SSH (rsync source + venv + systemd).

set -eu

# Site config: the VM's address, and the user and group startpg runs as there.
if [ ! -f config/deploy.env ]; then
    echo "deploy-live: create config/deploy.env (see the README)" >&2
    exit 1
fi
. ./config/deploy.env
: "${IP:?set IP in config/deploy.env}"
: "${RUN_USER:?set RUN_USER in config/deploy.env}"
: "${RUN_GROUP:?set RUN_GROUP in config/deploy.env}"

DEST=/opt/startpg
VM="$RUN_USER@$IP"

echo ">> Ensuring $DEST exists on $VM"
# Only the first deploy needs sudo for this; after that $DEST is the deploy
# user's own. sudo asks for the password afresh in every ssh session, so
# skipping it here leaves the install below as the only prompt.
ssh -t "$VM" "[ -d $DEST ] && [ -w $DEST ] || { sudo mkdir -p $DEST && sudo chown $RUN_USER:$RUN_GROUP $DEST; }"

echo ">> Syncing source to $VM:$DEST"
rsync -a --delete \
    --exclude '.git' \
    --exclude '.venv' \
    --exclude '__pycache__' \
    --exclude '*.egg-info' \
    --exclude '*.pyc' \
    --exclude '*_apikey.txt' \
    ./ "$VM:$DEST/"

echo ">> Installing on $VM"
# Build the remote script locally ($DEST expands here; \$HOME/\$PATH
# are deferred to the VM), then run it with `ssh -t` passing it as an argument.
# Keeping it off stdin leaves the terminal free for sudo's password prompt.
remote_install=$(cat <<EOF
set -eu
cd "$DEST"

# Ensure uv is available: a single static binary, far smaller and faster
# than apt's python3-pip (~300MB). Install it for this user if missing.
if ! command -v uv >/dev/null 2>&1 && [ ! -x "\$HOME/.local/bin/uv" ]; then
    curl -LsSf https://astral.sh/uv/install.sh | sh
fi
export PATH="\$HOME/.local/bin:\$PATH"

# Editable install into a uv-managed venv so templates, static, and
# startpg.yaml resolve from $DEST.
if [ ! -d .venv ]; then
    uv venv .venv
fi
uv pip install --python .venv/bin/python -e .

# Install/refresh the systemd units, filling in the user and group they run
# as, then enable the frontend and the timer.
for unit in face.service hiney.service hiney.timer; do
    sed -e "s/@RUN_USER@/$RUN_USER/g" -e "s/@RUN_GROUP@/$RUN_GROUP/g" \
        "packaging/systemd/\$unit" | sudo tee "/etc/systemd/system/\$unit" >/dev/null
done
sudo systemctl daemon-reload
sudo systemctl enable --now hiney.timer
sudo systemctl enable face.service

# Restart (not just enable --now) so face loads the freshly-installed code --
# enable --now won't restart an already-running unit, which is why a redeploy
# kept serving "?". Its Wants/After=hiney.service pulls a fresh sweep first,
# so face comes back up with data.
sudo systemctl restart face.service
EOF
)
ssh -t "$VM" "$remote_install"

echo ">> Done. face serves on http://$IP/ ; hiney runs every 5 min."

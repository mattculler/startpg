[Unit]
Description=startpg web frontend (face)
# Wait for one hiney run at boot so the page has data immediately instead of
# showing "?" until the first timer tick. Wants (not Requires) so a failed
# probe sweep doesn't keep the frontend down.
Wants=network-online.target hiney.service
After=network-online.target hiney.service

[Service]
Type=simple
# deploy-live fills these in from RUN_USER and RUN_GROUP in config/deploy.env.
User=@RUN_USER@
Group=@RUN_GROUP@
WorkingDirectory=/opt/startpg
# Serve on the well-known port directly. CAP_NET_BIND_SERVICE lets the
# unprivileged user bind <1024, so no NAT redirect is needed -- and hiney,
# probing from on the VM, sees the same thing a browser does.
Environment=STARTPG_PORT=80
AmbientCapabilities=CAP_NET_BIND_SERVICE
ExecStart=/opt/startpg/.venv/bin/face
RuntimeDirectory=startpg
RuntimeDirectoryPreserve=yes
# /var/lib/startpg: collapsed-section state, which unlike the DB in
# /run must survive reboots.
StateDirectory=startpg
Restart=on-failure

[Install]
WantedBy=multi-user.target

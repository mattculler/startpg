[Unit]
Description=startpg status probe (hiney)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# deploy-live fills these in from RUN_USER and RUN_GROUP in config/deploy.env.
User=@RUN_USER@
Group=@RUN_GROUP@
WorkingDirectory=/opt/startpg
ExecStart=/opt/startpg/.venv/bin/hiney
RuntimeDirectory=startpg
RuntimeDirectoryPreserve=yes
